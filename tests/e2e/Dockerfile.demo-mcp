FROM python:3.12-slim

WORKDIR /app
COPY auth-client/python /app/auth-client/python
COPY examples/demo-mcp /app/demo-mcp

RUN pip install --no-cache-dir \
      "/app/auth-client/python[fastmcp]" \
      "uvicorn>=0.30,<1"

RUN useradd --create-home --uid 1000 appuser \
    && chown -R appuser:appuser /app /app/demo-mcp
USER appuser
ENV PYTHONPATH=/app/demo-mcp \
    MCP_AUTH_JWKS_SSRF_SAFE=false
EXPOSE 6328
CMD ["python", "/app/demo-mcp/server.py"]
