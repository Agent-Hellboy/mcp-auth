FROM python:3.12-slim

RUN apt-get update \
    && apt-get install --no-install-recommends --yes nginx openssl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY examples/databricks-mcp /app/databricks
COPY auth-client/python /app/auth-client/python
COPY tests/e2e/mcp-as-client /app/mcp-as-client
COPY tests/e2e/start-databricks-e2e.sh /app/start-databricks-e2e.sh
COPY tests/e2e/nginx-databricks.conf /app/nginx-databricks.conf

RUN pip install --no-cache-dir \
      /app/auth-client/python \
      /app/mcp-as-client \
      "databricks-sdk>=0.80,<1" \
      "fastmcp>=3.4.4,<4" \
      "mcp>=1.27,<2" \
      "pyjwt[crypto]>=2.8,<3" \
      "sqlglot>=25,<30" \
      "uvicorn>=0.30,<1" \
    && pip install --no-cache-dir --no-deps /app/databricks

RUN useradd --create-home --uid 1000 appuser \
    && mkdir -p /var/lib/mcp-resource-auth /metrics \
    && chown -R appuser:appuser /app /var/lib/mcp-resource-auth /metrics \
    && chmod 0555 /app/start-databricks-e2e.sh /app/nginx-databricks.conf

WORKDIR /app/databricks
USER appuser
ENV PATH="/usr/local/bin:$PATH" \
    MCP_METRICS_ENABLED=false \
    MCP_METRICS_DB_PATH=/metrics/databricks-mcp-metrics.sqlite3 \
    MCP_AUTH_JWKS_SSRF_SAFE=false
EXPOSE 6328
ENTRYPOINT ["/app/start-databricks-e2e.sh"]
