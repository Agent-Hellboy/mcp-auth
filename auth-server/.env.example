MCP_AUTH_ISSUER=https://auth.example.com
MCP_AUTH_RESOURCE=https://mcp.example.com
MCP_AUTH_LISTEN_ADDR=:8080
MCP_AUTH_PRIVATE_KEY_FILE=/run/secrets/mcp-auth-signing-key.pem
MCP_AUTH_REGISTRATION_ENABLED=false
MCP_AUTH_LOCAL_DEVELOPMENT=false
MCP_AUTH_LOCAL_CLIENT_ID=
MCP_AUTH_LOCAL_TOKEN_EXCHANGE=false
MCP_AUTH_AUTHORIZATION_RESPONSE_ISS=true
MCP_AUTH_REQUIRE_HTTPS=true
MCP_AUTH_TRUSTED_ORIGINS=https://client.example.com
MCP_AUTH_ALLOWED_SCOPES=tools:read,tools:write
